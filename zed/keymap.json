// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Workspace",
        "bindings": {
            "shift shift": "pane::DeploySearch",
            "cmd-shift-a": "command_palette::Toggle",
            "cmd-alt-g": ["task::Spawn", { "task_name": "FastAPI" }],
            "cmd-alt-w": ["task::Spawn", { "task_name": "Taskiq Worker" }],
            "cmd-alt-s": ["task::Spawn", { "task_name": "Taskiq Scheduler" }],
            "cmd-alt-k": [
                "task::Spawn",
                { "task_name": "Stop Paydo Services" },
            ],
        },
    },
    {
        // PyCharm-style LSP navigation and hints
        "context": "Editor",
        "bindings": {
            "f1": "editor::Hover",
            "alt-f7": "editor::FindAllReferences",
            "cmd-alt-b": "editor::GoToImplementation",
            "cmd-alt-p": "editor::ShowSignatureHelp",
            "cmd-alt-l": "editor::Format",
            "cmd-alt-h": "editor::ToggleInlayHints",
        },
    },
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            // "j k": "vim::NormalBefore"
        },
    },
]
