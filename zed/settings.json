{
    "disable_ai": false,
    "edit_predictions": {
        "provider": "zed",
    },
    "diff_view_style": "split",
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
    },
    "agent": {
        "sidebar_side": "right",
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },
    "terminal": {
        "scroll_multiplier": 5.5,
        "font_size": 13.0,
        "font_family": "MesloLGS NF",
        "show_count_badge": true,
        "detect_venv": {
            "on": {
                "directories": [".env", "env", ".venv", "venv"],
                "activate_script": "default",
            },
        },
        "env": {},
        "toolbar": {
            "breadcrumbs": false,
        },
    },
    "icon_theme": {
        "mode": "light",
        "light": "Warm Charmed Icons",
        "dark": "Warm Charmed Icons",
    },
    "theme": {
        "mode": "dark",
        "light": "Catppuccin Iced Latte (Blur) [Heavy]",
        "dark": "Catppuccin Espresso (Blur) [Light]",
    },
    "theme_overrides": {
        "Catppuccin Espresso (Blur) [Light]": {
            "border.focused": "#8aadf4b3",
            "border.selected": "#c6a0f6b3",
            "border.disabled": "#6e738d80",
            // No UI outlines anywhere
            "border": "#00000000",
            "border.variant": "#00000000",
            "pane_group.border": "#00000000",
            "pane.focused_border": "#00000000",
            "panel.focused_border": "#00000000",
            "editor.line_number": "#8087a299",
            "editor.active_line_number": "#f4dbd6",
            "editor.subheader.background": "#1e2030e6",
            "hint": "#8087a2",
            "hint.background": "#8aadf41a",
            "created.background": "#a6da9533",
            "created.border": "#a6da9599",
            "deleted.background": "#ed879633",
            "deleted.border": "#ed879699",
            "modified.background": "#eed49f2e",
            "modified.border": "#eed49f99",
            "conflict.background": "#f5a97f33",
            "conflict.border": "#f5a97f99",
            "editor.diff_hunk.added.background": "#a6da9533",
            "editor.diff_hunk.added.hollow_background": "#a6da9514",
            "editor.diff_hunk.added.hollow_border": "#a6da95d9",
            "editor.diff_hunk.deleted.background": "#ed879633",
            "editor.diff_hunk.deleted.hollow_background": "#ed879614",
            "editor.diff_hunk.deleted.hollow_border": "#ed8796d9",
            "version_control.word_added": "#a6da9559",
            "version_control.word_deleted": "#ed879659",
            "version_control.conflict_marker.ours": "#a6da9540",
            "version_control.conflict_marker.theirs": "#8aadf440",
        },
        "Catppuccin Iced Latte (Blur) [Heavy]": {
            "border.focused": "#1e66f5b3",
            "border.selected": "#8839efb3",
            "border.disabled": "#9ca0b080",
            // No UI outlines anywhere
            "border": "#00000000",
            "border.variant": "#00000000",
            "pane_group.border": "#00000000",
            "pane.focused_border": "#00000000",
            "panel.focused_border": "#00000000",
            "editor.line_number": "#8c8fa1a6",
            "editor.active_line_number": "#1e66f5",
            "editor.subheader.background": "#dce0e8e6",
            "hint": "#8c8fa1",
            "hint.background": "#1e66f51a",
            "created.background": "#40a02b30",
            "created.border": "#40a02b99",
            "deleted.background": "#d20f3930",
            "deleted.border": "#d20f3999",
            "modified.background": "#df8e1d30",
            "modified.border": "#df8e1d99",
            "conflict.background": "#fe640b30",
            "conflict.border": "#fe640b99",
            "editor.diff_hunk.added.background": "#40a02b2b",
            "editor.diff_hunk.added.hollow_background": "#40a02b12",
            "editor.diff_hunk.added.hollow_border": "#40a02bd9",
            "editor.diff_hunk.deleted.background": "#d20f392b",
            "editor.diff_hunk.deleted.hollow_background": "#d20f3912",
            "editor.diff_hunk.deleted.hollow_border": "#d20f39d9",
            "version_control.word_added": "#40a02b4d",
            "version_control.word_deleted": "#d20f394d",
            "version_control.conflict_marker.ours": "#40a02b40",
            "version_control.conflict_marker.theirs": "#1e66f540",
        },
        "Aura Dark": {
            "editor.document_highlight.read_background": "#00000000",
            "editor.document_highlight.write_background": "#00000000",
            "border.variant": "#15141C",
            "border": "#15141C",
            "title_bar.background": "#15141C",
            "panel.background": "#15141C",
            "panel.focused_border": "#4E466E",
            "players": [
                {
                    "cursor": "#BD9DFF",
                },
            ],
            "syntax": {
                "comment": {
                    "font_style": "italic",
                },
                "comment.doc": {
                    "font_style": "italic",
                },
            },
        },
    },
    "title_bar": {
        "show_onboarding_banner": true,
        "show_project_items": true,
        "show_branch_name": true,
        "show_user_menu": true,
    },
    "tab_bar": {
        "show": false,
    },
    "toolbar": {
        "quick_actions": false,
    },
    "status_bar": {
        "experimental.show": true,
    },
    "project_panel": {
        "dock": "left",
        "default_width": 400,
        "hide_root": true,
        "auto_fold_dirs": false,
        "starts_open": false,
        "git_status": false,
        "sticky_scroll": false,
        "scrollbar": {
            "show": "never",
        },
        "indent_guides": {
            "show": "never",
        },
    },
    "outline_panel": {
        "default_width": 300,
        "indent_guides": {
            "show": "never",
        },
    },
    "file_finder": {
        "modal_max_width": "large",
    },
    "scrollbar": {
        "show": "never",
    },
    "gutter": {
        "min_line_number_digits": 0,
        "folds": false,
        "runnables": false,
    },
    "indent_guides": {
        "enabled": false,
    },
    "ui_font_family": "Dank Mono",
    "ui_font_size": 16,
    "buffer_font_family": "Dank Mono",
    "buffer_font_size": 18,
    "buffer_line_height": {
        "custom": 1.7,
    },
    "agent_buffer_font_size": 16,
    "vim_mode": true,
    "multi_cursor_modifier": "cmd_or_ctrl",
    "cursor_shape": "block",
    "cursor_blink": true,
    "selection_highlight": false,
    "drag_and_drop_selection": {
        "enabled": false,
    },
    "seed_search_query_from_cursor": "never",
    "current_line_highlight": "none",
    "show_whitespaces": "none",
    "tab_size": 4,
    // "auto_indent": "none",
    "auto_indent_on_paste": true,
    "show_completions_on_input": true,
    "show_completion_documentation": false,
    "completion_menu_item_kind": "symbol",
    "inline_code_actions": false,
    "lsp_document_colors": "none",
    "hover_popover_enabled": true,
    "hover_popover_delay": 300,
    "hover_popover_sticky": true,
    "auto_signature_help": true,
    "show_signature_help_after_edits": true,
    "minimum_contrast_for_highlights": 60,
    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_value_hints": true,
        "show_other_hints": true,
        "show_background": true,
        "edit_debounce_ms": 500,
        "scroll_debounce_ms": 50,
    },
    "diagnostics": {
        "inline": {
            "enabled": true,
            "update_debounce_ms": 150,
            "padding": 4,
            "min_column": 0,
        },
    },
    "format_on_save": "on",
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "auto_update": false,
    "extend_comment_on_newline": true,
    "horizontal_scroll_margin": 1,
    "vertical_scroll_margin": 1,
    "when_closing_with_no_tabs": "keep_window_open",
    "close_on_file_delete": true,
    "restore_on_file_reopen": false,
    "restore_on_startup": "launchpad",
    "session": {
        "restore_unsaved_buffers": false,
    },
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": {
            "enabled": false,
        },
    },
    "centered_layout": {
        "right_padding": 0.15,
        "left_padding": 0.15,
    },
    "languages": {
        "Python": {
            // "show_whitespaces": "all",
            // "show_edit_predictions": false,
            // "hard_tabs": false,
            "format_on_save": "on",
            "formatter": {
                "language_server": {
                    "name": "ruff",
                },
            },
            "language_servers": [
                "ty",
                "ruff",
                "!basedpyright",
                "!pyrefly",
                "!pyright",
                "!pylsp",
            ],
        },
    },
    "file_scan_exclusions": [
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.settings",
        // above is default from Zed
        "**/out",
        "**/dist",
        "**/.husky",
        "**/.turbo",
        "**/.vscode-test",
        "**/.vscode",
        "**/.next",
        "**/.storybook",
        "**/.tap",
        "**/.nyc_output",
        "**/report",
        "**/node_modules",
    ],
    // File syntax highlighting
    "file_types": {
        "Dockerfile": ["Dockerfile", "Dockerfile.*"],
        "JSON": ["json", "jsonc", "*.code-snippets"],
    },
}
